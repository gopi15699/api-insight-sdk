PORT=5001
# Note: port 5000 is reserved by macOS AirPlay/Control Center on macOS 12+
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/api-insight

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Alerts
ALERT_EMAIL_FROM=alerts@api-insight.com
ALERT_EMAIL_TO=admin@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Error threshold for alerts
ALERT_ERROR_THRESHOLD=10

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Public dashboard URL (used for Stripe Checkout success/cancel return)
FRONTEND_URL=http://localhost:3000

# ── GitHub OAuth (optional) ───────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: <FRONTEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OTP / verification ────────────────────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SEC=60

# ── SMS provider (optional — mobile OTP is inactive until configured) ──────────
# Implement the provider branch in src/utils/sms.ts, then set these.
SMS_PROVIDER=
SMS_FROM=
SMS_API_KEY=
SMS_API_SECRET=

# ── Stripe billing (optional — leave blank to disable billing) ────────────────
# Get the secret key from https://dashboard.stripe.com/apikeys (use Test Mode
# for development). The webhook secret comes from the webhook endpoint you add
# (Developers → Webhooks). See BILLING.md for full setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — generate the products/prices with `npm run seed:stripe`,
# then paste the printed price_xxx ids here.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=
